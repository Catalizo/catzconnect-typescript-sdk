{
  "name": "catzconnect",
  "version": "2.0.0",
  "description": "unified communication gateway",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Catalizo/catzconnect-typescript-sdk.git"
  },
  "scripts": {
    "build": "tsup src/index.ts src/push.ts src/call.ts --format cjs,esm && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "author": "catalizo",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "libsodium-wrappers-sumo": "^0.8.4"
  },
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./push": {
      "types": "./dist/push.d.ts",
      "import": "./dist/push.mjs",
      "require": "./dist/push.js"
    },
    "./call": {
      "types": "./dist/call.d.ts",
      "import": "./dist/call.mjs",
      "require": "./dist/call.js"
    }
  }
}
